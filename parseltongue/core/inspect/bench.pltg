; bench.pltg — bench package entry point
;
; Imports all bench result forms and re-exports as unprefixed aliases.
; Axioms live in the sub-modules (bench_pg/*.pltg) using namespaced symbols.
; Python constructors emit namespaced tags (bench_pg.search.sr, etc.)
; so the axioms match. Users type alias names (sr-doc, ln-kind, etc.)
; which resolve at head position.
;
; Usage: (sr-doc result), (ln-kind node), (dx-category item), etc.

(import (quote std.std))
(import (quote bench_pg.view))

; ── view aliases ──
(import (quote bench_pg.view.fmt))
(import (quote bench_pg.view.sr-fmt))
(import (quote bench_pg.view.ln-fmt))
(import (quote bench_pg.view.dx-fmt))
(import (quote bench_pg.view.hn-fmt))

(import (quote bench_pg.search))
(import (quote bench_pg.lens))
(import (quote bench_pg.evaluation))
(import (quote bench_pg.hologram))



; ── sr aliases ──
(import (quote bench_pg.search.sr))
(import (quote bench_pg.search.sr-doc))
(import (quote bench_pg.search.sr-line))
(import (quote bench_pg.search.sr-column))
(import (quote bench_pg.search.sr-context))
(import (quote bench_pg.search.sr-callers))

; ── ln aliases ──
(import (quote bench_pg.lens.ln))
(import (quote bench_pg.lens.ln-name))
(import (quote bench_pg.lens.ln-kind))
(import (quote bench_pg.lens.ln-value))
(import (quote bench_pg.lens.ln-depth))
(import (quote bench_pg.lens.ln-inputs))

; ── dx aliases ──
(import (quote bench_pg.evaluation.dx))
(import (quote bench_pg.evaluation.dx-name))
(import (quote bench_pg.evaluation.dx-category))
(import (quote bench_pg.evaluation.dx-kind))
(import (quote bench_pg.evaluation.dx-type))
(import (quote bench_pg.evaluation.dx-detail))

; ── hn aliases ──
(import (quote bench_pg.hologram.hn))
(import (quote bench_pg.hologram.hn-name))
(import (quote bench_pg.hologram.hn-kind))
(import (quote bench_pg.hologram.hn-value))
(import (quote bench_pg.hologram.hn-lenses))

