; ops.pltg — unified operations module
;
; Imports general and specialized ops, provides standard aliases:
;   or    → or-forms
;   and   → and-forms
;   not   → not-forms
;   count → count-forms
;   limit → limit-forms

(import (quote std.std))
(import (quote .general_ops))
(import (quote .specialized_ops))

; ── tag constructor aliases (bare names matching scope output) ──
(import (quote specialized_ops.lens.ln))
(import (quote specialized_ops.search.sr))
(import (quote specialized_ops.evaluation.dx))
(import (quote specialized_ops.hologram.hn))

; ── operation aliases ──
(import (quote general_ops.or-forms-call or-forms))
(import (quote specialized_ops.and-forms))
(import (quote specialized_ops.not-forms))
(import (quote general_ops.count-forms))
(import (quote general_ops.limit-forms))
(import (quote specialized_ops.keys))
(import (quote std.std.lists.cons))
(import (quote std.std.lists.cons-prepend))
(import (quote std.std.lists.concat))
