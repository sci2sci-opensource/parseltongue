; std.pltg — Manually verify stdlib defterms and axioms.
;
; All stdlib definitions use :origin (no document source).
; verify-manual marks them as manually verified so they pass consistency.
;
; Names use bare module prefixes (counting.X not std.counting.X) so
; patch_symbols resolves them via module aliases regardless of whether
; std is loaded as a lib or via relative import.

; --- counting.pltg ---
(verify-manual (quote counting.count-exists) "V")
(verify-manual (quote counting.count-exists-base) "V")
(verify-manual (quote counting.count-exists-step) "V")
(verify-manual (quote counting.sum-values) "V")
(verify-manual (quote counting.sum-values-base) "V")
(verify-manual (quote counting.sum-values-step) "V")

