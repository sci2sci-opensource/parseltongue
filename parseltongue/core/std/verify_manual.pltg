; std.pltg — Manually verify stdlib defterms and axioms.
;
; All stdlib definitions use :origin (no document source).
; verify-manual marks them as manually verified so they pass consistency.

; --- counting.pltg ---
(verify-manual (quote std.counting.count-exists) "V")
(verify-manual (quote std.counting.count-exists-base) "V")
(verify-manual (quote std.counting.count-exists-step) "V")
(verify-manual (quote std.counting.sum-values) "V")
(verify-manual (quote std.counting.sum-values-base) "V")
(verify-manual (quote std.counting.sum-values-step) "V")

