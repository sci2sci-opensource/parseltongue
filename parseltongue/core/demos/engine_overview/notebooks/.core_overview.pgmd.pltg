;; @@block 1 d8009009997cc8095b6561e4074d7779eaff34ea6e6cb6698029ecd1135348a9
;; pltg Counts
(derive engine-fact-count (std.counting.count-exists
  engine.consistency-checks-three-layers
  engine.consistency-doc
  engine.derive-resolves-definition
  engine.diff-evaluated-structurally
  engine.fact-stores-evidence)
  :using (std.counting.count-exists-base std.counting.count-exists-step
    engine.consistency-checks-three-layers engine.consistency-doc
    engine.derive-resolves-definition engine.diff-evaluated-structurally
    engine.fact-stores-evidence))
engine-fact-count

;; @@end 1
