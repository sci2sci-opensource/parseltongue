;; @@block 3 7e848129908369e36bb7f42109e386b3b38b0e6d8b17182115ac9117466218b7
;; pltg Error Witnesses
(derive error-witness-count (std.counting.count-exists
  engine.witness-evidence-hallucinated
  engine.witness-no-evidence-hallucinated
  engine.witness-fabrication-does-not-hold
  engine.witness-fabrication-ungrounded-source
  engine.witness-evidence-unknown)
  :using (std.counting.count-exists-base std.counting.count-exists-step
    engine.witness-evidence-hallucinated engine.witness-no-evidence-hallucinated
    engine.witness-fabrication-does-not-hold engine.witness-fabrication-ungrounded-source
    engine.witness-evidence-unknown))
error-witness-count

