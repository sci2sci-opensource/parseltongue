;; AI2AI — derivation rules, computed metrics, and business validation
;; Used by implicit.pgmd (prose-heavy notebook that references computed results)

(import (quote ..facts.ai2ai_facts))

;; ── Unit economics ──
(derive gross-profit (- ai2ai_facts.revenue ai2ai_facts.cogs)
  :using (ai2ai_facts.revenue ai2ai_facts.cogs))

(derive gross-margin (/ gross-profit ai2ai_facts.revenue)
  :using (gross-profit ai2ai_facts.revenue))

(derive ltv-to-cac (/ ai2ai_facts.ltv ai2ai_facts.cac)
  :using (ai2ai_facts.ltv ai2ai_facts.cac))

(derive arr-per-customer (/ ai2ai_facts.arr ai2ai_facts.total-customers)
  :using (ai2ai_facts.arr ai2ai_facts.total-customers))

(derive enterprise-arr-pct (/ ai2ai_facts.enterprise-arr ai2ai_facts.arr)
  :using (ai2ai_facts.enterprise-arr ai2ai_facts.arr))

;; ── Runway ──
(derive runway-months (/ ai2ai_facts.cash ai2ai_facts.monthly-burn)
  :using (ai2ai_facts.cash ai2ai_facts.monthly-burn))

(derive post-raise-cash (+ ai2ai_facts.cash ai2ai_facts.round-size)
  :using (ai2ai_facts.cash ai2ai_facts.round-size))

(derive post-raise-runway (/ post-raise-cash ai2ai_facts.monthly-burn)
  :using (post-raise-cash ai2ai_facts.monthly-burn))

;; ── Efficiency ──
(derive burn-multiple (/ ai2ai_facts.monthly-burn ai2ai_facts.mrr)
  :using (ai2ai_facts.monthly-burn ai2ai_facts.mrr))

(derive opex-to-revenue (/ ai2ai_facts.total-opex ai2ai_facts.revenue)
  :using (ai2ai_facts.total-opex ai2ai_facts.revenue))

(derive sales-efficiency (/ ai2ai_facts.arr ai2ai_facts.sales-expense)
  :using (ai2ai_facts.arr ai2ai_facts.sales-expense))

(derive revenue-per-head (/ ai2ai_facts.revenue ai2ai_facts.headcount)
  :using (ai2ai_facts.revenue ai2ai_facts.headcount))

(derive revenue-per-engineer (/ ai2ai_facts.revenue ai2ai_facts.eng-headcount)
  :using (ai2ai_facts.revenue ai2ai_facts.eng-headcount))

;; ── Engagement ──
(derive dau-wau-ratio (/ ai2ai_facts.dau ai2ai_facts.wau)
  :using (ai2ai_facts.dau ai2ai_facts.wau))

(derive reviews-per-dau (/ ai2ai_facts.monthly-reviews ai2ai_facts.dau)
  :using (ai2ai_facts.monthly-reviews ai2ai_facts.dau))

;; ── Pipeline projections ──
(derive expected-pipeline-conversion
  (/ (* ai2ai_facts.pipeline-arr ai2ai_facts.pilot-conversion-pct) 100)
  :using (ai2ai_facts.pipeline-arr ai2ai_facts.pilot-conversion-pct))

(derive projected-arr-12mo
  (+ (+ ai2ai_facts.arr expected-pipeline-conversion) ai2ai_facts.expansion-revenue)
  :using (ai2ai_facts.arr expected-pipeline-conversion ai2ai_facts.expansion-revenue))

;; ── Valuation ──
(derive arr-multiple (/ ai2ai_facts.pre-money ai2ai_facts.arr)
  :using (ai2ai_facts.pre-money ai2ai_facts.arr))

(derive enterprise-pct (/ ai2ai_facts.enterprise-customers ai2ai_facts.total-customers)
  :using (ai2ai_facts.enterprise-customers ai2ai_facts.total-customers))

;; ── Business rule assertions ──

(axiom margin-healthy (> ?margin 0.6)
  :origin "business rule: gross margin must exceed 60% for software")
(derive margin-check margin-healthy
  :bind ((?margin gross-margin))
  :using (gross-margin margin-healthy))

(axiom runway-sufficient (> ?months 12)
  :origin "business rule: pre-raise runway should exceed 12 months")
(derive runway-check runway-sufficient
  :bind ((?months runway-months))
  :using (runway-months runway-sufficient))

(axiom ltv-cac-healthy (> ?ratio 3.0)
  :origin "business rule: LTV/CAC must exceed 3x")
(derive ltv-cac-check ltv-cac-healthy
  :bind ((?ratio ltv-to-cac))
  :using (ltv-to-cac ltv-cac-healthy))

(axiom retention-strong (> ?nrr 130)
  :origin "business rule: NRR must exceed 130% for expansion-driven model")
(derive retention-check retention-strong
  :bind ((?nrr ai2ai_facts.nrr))
  :using (ai2ai_facts.nrr retention-strong))

(axiom churn-acceptable (< ?churn 2.0)
  :origin "business rule: monthly churn must be below 2%")
(derive churn-check churn-acceptable
  :bind ((?churn ai2ai_facts.monthly-churn-pct))
  :using (ai2ai_facts.monthly-churn-pct churn-acceptable))

(axiom engagement-strong (> ?ratio 0.4)
  :origin "business rule: DAU/WAU ratio should exceed 40%")
(derive engagement-check engagement-strong
  :bind ((?ratio dau-wau-ratio))
  :using (dau-wau-ratio engagement-strong))

(axiom valuation-reasonable (< ?multiple 25)
  :origin "business rule: ARR multiple should be below 25x for Series A")
(derive valuation-check valuation-reasonable
  :bind ((?multiple arr-multiple))
  :using (arr-multiple valuation-reasonable))

(axiom pipeline-covers-gap (> ?projected 5000000)
  :origin "business rule: projected 12-month ARR must exceed $5M")
(derive pipeline-check pipeline-covers-gap
  :bind ((?projected projected-arr-12mo))
  :using (projected-arr-12mo pipeline-covers-gap))
