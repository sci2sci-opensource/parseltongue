;; @@block 0 8d738f3a5fe6d5f84fe1c024017ad3cb67de8dab9724bcd56308b7dbd1659565
;; pltg Load Facts
(import (quote ..facts.ai2ai_facts ai2ai_facts))

;; @@end 0
;; @@block 1 c4f5c13c997576ec3e4b6de9e94212bda381a2b08e3083cd565086d590d4d8a3
;; pltg Gross Margin
(derive gross-profit (- ai2ai_facts.revenue ai2ai_facts.cogs) :using (ai2ai_facts.revenue ai2ai_facts.cogs))
(derive gross-margin (/ gross-profit ai2ai_facts.revenue) :using (gross-profit ai2ai_facts.revenue))
(print "Gross profit:")
gross-margin

;; @@end 1
;; @@block 2 84f6073b4725de60761662955505d593f7b2fb1746e692c0bd31a60f364592ee
;; pltg Margin Validation
(axiom margin-healthy (> ?margin 0.6)
  :origin "business rule: gross margin must exceed 60% for software")
(derive margin-check margin-healthy
  :bind ((?margin gross-margin))
  :using (gross-margin margin-healthy))
margin-check

;; @@end 2
;; @@block 3 0bb8c553017df0b3b32bf0e8b8b1833f1922c9eb84a0cbc5d46224a8ef35b375
;; pltg LTV/CAC
(derive ltv-to-cac (/ ai2ai_facts.ltv ai2ai_facts.cac) :using (ai2ai_facts.ltv ai2ai_facts.cac))
(derive arr-per-customer (/ ai2ai_facts.arr ai2ai_facts.total-customers) :using (ai2ai_facts.arr ai2ai_facts.total-customers))
(print "LTV/CAC ratio:")
ltv-to-cac

;; @@end 3
;; @@block 4 134bfbf04bb6abf4e5d745c05ebe153d8663d6e07028e420ac076c4f13939dda
;; pltg Retention & Churn
(axiom ltv-cac-healthy (> ?ratio 3.0)
  :origin "business rule: LTV/CAC must exceed 3x")
(derive ltv-cac-check ltv-cac-healthy
  :bind ((?ratio ltv-to-cac))
  :using (ltv-to-cac ltv-cac-healthy))

(axiom retention-strong (> ?nrr 130)
  :origin "business rule: NRR must exceed 130% for expansion-driven model")
(derive retention-check retention-strong
  :bind ((?nrr ai2ai_facts.nrr))
  :using (ai2ai_facts.nrr retention-strong))

(axiom churn-acceptable (< ?churn 2.0)
  :origin "business rule: monthly churn must be below 2%")
(derive churn-check churn-acceptable
  :bind ((?churn ai2ai_facts.monthly-churn-pct))
  :using (ai2ai_facts.monthly-churn-pct churn-acceptable))
churn-check

;; @@end 4
;; @@block 5 54deb71535ac98cefe929b331805aa83cb70edbde4d48f60890d043bf2814b1a
;; pltg Runway
(derive runway-months (/ ai2ai_facts.cash ai2ai_facts.monthly-burn) :using (ai2ai_facts.cash ai2ai_facts.monthly-burn))
(derive post-raise-cash (+ ai2ai_facts.cash ai2ai_facts.round-size) :using (ai2ai_facts.cash ai2ai_facts.round-size))
(derive post-raise-runway (/ post-raise-cash ai2ai_facts.monthly-burn) :using (post-raise-cash ai2ai_facts.monthly-burn))
(derive burn-multiple (/ ai2ai_facts.monthly-burn ai2ai_facts.mrr) :using (ai2ai_facts.monthly-burn ai2ai_facts.mrr))
(derive sales-efficiency (/ ai2ai_facts.arr ai2ai_facts.sales-expense) :using (ai2ai_facts.arr ai2ai_facts.sales-expense))
(print "Current runway:")
runway-months

;; @@end 5
;; @@block 6 8be807f3710b8e9bdd36b20c1cb873e62bc5056928fd062729399521f3557f87
;; pltg Pipeline Projection
(derive expected-pipeline-conversion
  (/ (* ai2ai_facts.pipeline-arr ai2ai_facts.pilot-conversion-pct) 100)
  :using (ai2ai_facts.pipeline-arr ai2ai_facts.pilot-conversion-pct))

(derive projected-arr-12mo
  (+ (+ ai2ai_facts.arr expected-pipeline-conversion) ai2ai_facts.expansion-revenue)
  :using (ai2ai_facts.arr expected-pipeline-conversion ai2ai_facts.expansion-revenue))

(axiom pipeline-covers-gap (> ?projected 5000000)
  :origin "business rule: projected 12-month ARR must exceed $5M")
(derive pipeline-check pipeline-covers-gap
  :bind ((?projected projected-arr-12mo))
  :using (projected-arr-12mo pipeline-covers-gap))
projected-arr-12mo

;; @@end 6
;; @@block 7 9fb07e5e25d08936c028d805ae12cbaf967ba5e9ea732bd8ac7637863b7880ce
;; pltg Engagement Metrics
(derive dau-wau-ratio (/ ai2ai_facts.dau ai2ai_facts.wau) :using (ai2ai_facts.dau ai2ai_facts.wau))
(derive reviews-per-dau (/ ai2ai_facts.monthly-reviews ai2ai_facts.dau) :using (ai2ai_facts.monthly-reviews ai2ai_facts.dau))
(derive revenue-per-head (/ ai2ai_facts.revenue ai2ai_facts.headcount) :using (ai2ai_facts.revenue ai2ai_facts.headcount))

(axiom engagement-strong (> ?ratio 0.4)
  :origin "business rule: DAU/WAU should exceed 40%")
(derive engagement-check engagement-strong
  :bind ((?ratio dau-wau-ratio))
  :using (dau-wau-ratio engagement-strong))
dau-wau-ratio

;; @@end 7
;; @@block 8 6c2ac1aee937566bcb4f0c205caed5347753917a4283c6f8137fa0912bdfad1b
;; pltg Valuation
(derive arr-multiple (/ ai2ai_facts.pre-money ai2ai_facts.arr) :using (ai2ai_facts.pre-money ai2ai_facts.arr))
(derive enterprise-pct (/ ai2ai_facts.enterprise-customers ai2ai_facts.total-customers) :using (ai2ai_facts.enterprise-customers ai2ai_facts.total-customers))

(axiom valuation-reasonable (< ?multiple 25)
  :origin "business rule: ARR multiple should be below 25x for Series A")
(derive valuation-check valuation-reasonable
  :bind ((?multiple arr-multiple))
  :using (arr-multiple valuation-reasonable))
arr-multiple

;; @@end 8
;; @@block 9 c4f649a4bf4109c286e09a5260e1c4d9507e612d4aaa40406577eec18e7594ce
;; pltg Broken Block
(derive phantom (/ nonexistent-metric 100) :using (nonexistent-metric))
phantom

;; @@end 9
