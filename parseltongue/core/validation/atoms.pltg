; atoms.pltg — Ground truth and internal validation for atoms.py

(load-document "atoms.py" "../atoms.py")
(import (quote ..std.counting))
(import (quote ..std.util))
(defterm count-exists counting.count-exists :origin "import")

; =====================================================================
; Module contract — what the docstring promises
; =====================================================================

(fact module-claims-pure-types true
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "Module docstring claims pure types"))

(fact module-claims-no-domain true
    :evidence (evidence "atoms.py"
        :quotes ("No domain knowledge, no state.")
        :explanation "Module docstring claims no domain knowledge"))

; Axiom: purity implies immutability — pure types should be frozen
(axiom purity-implies-immutable
    (implies ?pure (not ?mutable))
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "Module docstring claims both purity and statelessness — pure types with no state should be immutable"))

; Code facts: frozen/immutable status of each atom type
(fact symbol-is-immutable true
    :evidence (evidence "atoms.py"
        :quotes ("class Symbol(str):")
        :explanation "Symbol inherits from str — immutable by construction"))

(fact evidence-is-frozen true
    :evidence (evidence "atoms.py"
        :quotes ("@dataclass(frozen=True, init=False)\nclass Evidence:")
        :explanation "Evidence is a frozen dataclass"))

(fact axiom-class-is-frozen true
    :evidence (evidence "atoms.py"
        :quotes ("@dataclass(frozen=True)\nclass Axiom:")
        :explanation "Axiom is a frozen dataclass"))

(fact theorem-class-is-frozen true
    :evidence (evidence "atoms.py"
        :quotes ("@dataclass(frozen=True)\nclass Theorem:")
        :explanation "Theorem is a frozen dataclass"))

(fact term-class-is-frozen true
    :evidence (evidence "atoms.py"
        :quotes ("@dataclass(frozen=True)\nclass Term:")
        :explanation "Term is a frozen dataclass"))

; =====================================================================
; Symbol
; =====================================================================

(fact symbol-base-class "str"
    :evidence (evidence "atoms.py"
        :quotes ("class Symbol(str):")
        :explanation "Symbol subclasses str"))

(fact symbol-docstring "A symbol in Parseltongue. Just a string with a distinct type."
    :evidence (evidence "atoms.py"
        :quotes ("A symbol in Parseltongue. Just a string with a distinct type.")
        :explanation "Symbol's documented purpose"))

; =====================================================================
; Evidence — the grounding mechanism
; =====================================================================

(fact evidence-docstring "Structured evidence: typed claims about a typed source."
    :evidence (evidence "atoms.py"
        :quotes ("Structured evidence: typed claims about a typed source.")
        :explanation "Evidence's documented purpose"))

(fact evidence-verified-default false
    :evidence (evidence "atoms.py"
        :quotes ("verified: bool = False")
        :explanation "Not verified until proven"))

(fact evidence-verify-manual-default false
    :evidence (evidence "atoms.py"
        :quotes ("verify_manual: bool = False")
        :explanation "Not manually verified by default"))

(fact evidence-grounded-doc "Evidence is grounded if verified or manually verified."
    :evidence (evidence "atoms.py"
        :quotes ("Evidence is grounded if verified or manually verified.")
        :explanation "is_grounded docstring"))

(fact evidence-grounded-impl "verified-or-manual"
    :evidence (evidence "atoms.py"
        :quotes ("return self.verified or self.verify_manual")
        :explanation "is_grounded implementation"))

; Axiom from docstring: grounding requires verified or manual
(axiom grounding-rule-doc (implies ?grounded (or ?verified ?manual))
    :evidence (evidence "atoms.py"
        :quotes ("Evidence is grounded if verified or manually verified.")
        :explanation "Docstring: grounding has no path outside verified/manual"))

; Axiom from code: grounding requires verified or manual
(axiom grounding-rule-impl (implies ?grounded (or ?verified ?manual))
    :evidence (evidence "atoms.py"
        :quotes ("return self.verified or self.verify_manual")
        :explanation "Implementation: is_grounded = verified OR verify_manual"))

; =====================================================================
; Axiom class — what it documents about itself
; =====================================================================

(fact axiom-docstring "An axiom: a foundational WFF assumed true, with evidence."
    :evidence (evidence "atoms.py"
        :quotes ("An axiom: a foundational WFF assumed true, with evidence.")
        :explanation "Axiom's self-description"))

(fact axiom-has-origin true
    :evidence (evidence "atoms.py"
        :quotes ("origin: \"str | Evidence\"")
        :explanation "Axiom tracks its origin"))

; Axiom: every axiom carries origin (str or Evidence)
(axiom origin-is-provenance (= ?origin ?provenance)
    :evidence (evidence "atoms.py"
        :quotes ("origin: \"str | Evidence\"")
        :explanation "Origin is the provenance mechanism"))

; =====================================================================
; Theorem class
; =====================================================================

(fact theorem-docstring "A theorem: a WFF derived from facts, axioms, terms, or other theorems."
    :evidence (evidence "atoms.py"
        :quotes ("A theorem: a WFF derived from facts, axioms, terms, or other theorems.")
        :explanation "Theorem's self-description"))

(fact theorem-default-origin "derived"
    :evidence (evidence "atoms.py"
        :quotes ("origin: \"str | Evidence\" = \"derived\"")
        :explanation "Theorem origin defaults to derived"))

(fact theorem-has-derivation true
    :evidence (evidence "atoms.py"
        :quotes ("derivation: list")
        :explanation "Theorem records what it was derived from"))

; Theorem docstring says "derived from axioms/terms via substitution"
; but derivation list can also include facts and other theorems
; Both facts answer: "does the docstring document all derivation sources?"
(fact theorem-doc-covers-all-sources true
    :evidence (evidence "atoms.py"
        :quotes ("A theorem: a WFF derived from facts, axioms, terms, or other theorems.")
        :explanation "Docstring lists all derivation source types"))

(fact theorem-impl-accepts-all-sources true
    :evidence (evidence "atoms.py"
        :quotes ("derivation: list")
        :explanation "Derivation list accepts any source type"))

(diff theorem-derivation-sources
    :replace theorem-doc-covers-all-sources
    :with theorem-impl-accepts-all-sources)

; =====================================================================
; Term class
; =====================================================================

(fact term-docstring "A term/concept/primitive introduced into the system."
    :evidence (evidence "atoms.py"
        :quotes ("A term/concept/primitive introduced into the system.")
        :explanation "Term's self-description"))

(fact term-forward-decl-display "(primitive)"
    :evidence (evidence "atoms.py"
        :quotes ("if self.definition is not None else \"(primitive)\"")
        :explanation "Forward-declared terms display as (primitive)"))

; =====================================================================
; Reader pipeline: tokenize -> read_tokens -> atom
; =====================================================================

(fact tokenize-doc false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "tokenize moved to the grammar layer — atoms.py no longer contains or documents a tokenizer"))

(fact comment-char false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "Comment handling left atoms.py with the tokenizer — no reader code remains here"))

(fact read-tokens-doc false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "read_tokens moved to the grammar layer — no reader code remains in atoms.py"))

(fact atom-doc false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "atom() moved to the grammar layer — atoms.py no longer documents token conversion"))

; atom() conversion chain: int -> float -> bool -> string -> keyword -> Symbol
(fact atom-tries-int-first false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "atom()'s conversion chain moved to the grammar layer — no int conversion in atoms.py"))

(fact atom-tries-float-second false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "atom()'s conversion chain moved to the grammar layer — no float conversion in atoms.py"))

(fact atom-keyword-prefix false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "Keyword-token handling moved to the grammar layer — not in atoms.py"))

(fact atom-fallback-is-symbol false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "atom()'s Symbol fallback moved to the grammar layer — atoms.py only defines the Symbol type"))

; =====================================================================
; parse / parse_all contract
; =====================================================================

(fact parse-doc false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "parse moved to the grammar layer — atoms.py contains no parsing"))

(fact parse-all-doc false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "parse_all moved to the grammar layer — atoms.py contains no parsing"))

; parse is tokenize + single read_tokens
; parse_all is tokenize + loop of read_tokens
; Theorem: parse_all on single-expression input returns [parse(input)]

; =====================================================================
; to_sexp — roundtrip printer
; =====================================================================

(fact to-sexp-doc false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "to_sexp moved to the grammar layer — printing in atoms.py goes through ParseltongueGrammar.enc"))

(fact to-sexp-bool-true false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "Boolean printing moved to the grammar layer with to_sexp — not in atoms.py"))

(fact to-sexp-bool-false false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "Boolean printing moved to the grammar layer with to_sexp — not in atoms.py"))

; =====================================================================
; DSL helpers — match, free_vars, substitute
; =====================================================================

(fact match-doc false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "match moved to the grammar layer — atoms.py has no pattern matching"))

(fact free-vars-doc false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "free_vars moved to the grammar layer — not in atoms.py"))

(fact substitute-doc false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "substitute moved to the grammar layer — not in atoms.py"))

; Splat pattern support — docstring ground truth
(fact match-splat-doc false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "match and its ?... splat documentation moved to the grammar layer — not in atoms.py"))

(fact substitute-splat-doc false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "substitute and its ?... splicing documentation moved to the grammar layer — not in atoms.py"))

; Axiom: match produces bindings that substitute can consume
(axiom match-substitute-roundtrip
    (= (implies (?bindings ?pattern ?expr) (= ?expr (?substitute ?pattern ?bindings))) true)
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "match and substitute moved to the grammar layer — the roundtrip schema is retained unbound, no longer grounded in atoms.py"))

; =====================================================================
; Internal consistency: module contract vs content
; =====================================================================

; Module says "No state" — verify no mutable module-level state
; atoms.py has no module-level mutable state — only classes and functions. Consistent.

(derive module-is-stateless
    (and module-claims-pure-types module-claims-no-domain)
    :using (module-claims-pure-types module-claims-no-domain))

; atom() true/false token values
(fact atom-true-token false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "atom() token handling moved to the grammar layer — no true-token branch in atoms.py"))

(fact atom-false-token false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "atom() token handling moved to the grammar layer — no false-token branch in atoms.py"))

; Derive: atom() and to_sexp are roundtrip-compatible for booleans
; atom("true") -> True, to_sexp(True) -> "true"
(derive bool-roundtrip-consistent
    (= atom-true-token to-sexp-bool-true)
    :using (atom-true-token to-sexp-bool-true))

; Evidence str format uses is_grounded to decide status label
(defterm evidence-unverified-status "UNVERIFIED"
    :evidence (evidence "atoms.py"
        :quotes ("status = \"grounded\" if self.is_grounded else \"UNVERIFIED\"")
        :explanation "Unverified evidence displays UNVERIFIED"))

(defterm evidence-grounded-status "grounded"
    :evidence (evidence "atoms.py"
        :quotes ("status = \"grounded\" if self.is_grounded else \"UNVERIFIED\"")
        :explanation "Grounded evidence displays grounded"))

; Term display logic: primitive vs computed
(fact term-has-body-display "ParseltongueGrammar.enc"
    :evidence (evidence "atoms.py"
        :quotes ("ParseltongueGrammar.enc(self.definition)")
        :explanation "Terms with a body display via ParseltongueGrammar.enc"))

(fact term-definition-check "self.definition is not None"
    :evidence (evidence "atoms.py"
        :quotes ("if self.definition is not None")
        :explanation "Display branches on whether definition exists"))

(axiom term-display-rule
    (if ?has-definition ?to-sexp ?primitive)
    :evidence (evidence "atoms.py"
        :quotes ("ParseltongueGrammar.enc(self.definition) if self.definition is not None else \"(primitive)\"")
        :explanation "If has definition show sexp, else show (primitive)"))

; Display says "primitive" — does the docstring agree?
(fact term-display-says-primitive true
    :evidence (evidence "atoms.py"
        :quotes ("(primitive)")
        :explanation "Forward-declared terms display as primitive"))

(fact term-docstring-says-primitive true
    :evidence (evidence "atoms.py"
        :quotes ("A term/concept/primitive introduced into the system.")
        :explanation "Docstring includes primitive"))

(diff term-label-consistency
    :replace term-display-says-primitive
    :with term-docstring-says-primitive)

(derive term-display-documented
    (and term-definition-check term-docstring-says-primitive)
    :using (term-definition-check term-docstring-says-primitive))

; =====================================================================
; Code vs Docs — two-branch-then-diff
; =====================================================================

; --- 1. Reader pipeline function count ---

(derive reader-doc-count
    (count-exists tokenize-doc read-tokens-doc atom-doc parse-doc parse-all-doc comment-char)
    :using (count-exists counting.count-exists-base counting.count-exists-step
            tokenize-doc read-tokens-doc atom-doc parse-doc parse-all-doc comment-char))

(defterm reader-impl-count 0
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state."
                 "Atoms is the foundation layer (pure types, no behavior). Grammar depends\n# on atoms for Symbol/Silence/WFF — that's correct.")
        :explanation "Reader pipeline moved to the grammar layer — 0 reader features remain in atoms.py"))

(diff reader-pipeline-coverage
    :replace reader-doc-count
    :with reader-impl-count)

; --- 2. Atom conversion chain ---

(derive atom-conv-doc-count
    (count-exists atom-tries-int-first atom-tries-float-second atom-keyword-prefix atom-false-token atom-fallback-is-symbol)
    :using (count-exists counting.count-exists-base counting.count-exists-step
            atom-tries-int-first atom-tries-float-second atom-keyword-prefix atom-false-token atom-fallback-is-symbol))

(defterm atom-conv-impl-count 0
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state."
                 "Atoms is the foundation layer (pure types, no behavior). Grammar depends\n# on atoms for Symbol/Silence/WFF — that's correct.")
        :explanation "atom() and its conversion branches moved to the grammar layer — 0 remain in atoms.py"))

(diff atom-conversion-coverage
    :replace atom-conv-doc-count
    :with atom-conv-impl-count)

; --- 3. Core type documentation ---

(derive core-types-doc-count
    (count-exists symbol-docstring symbol-base-class evidence-docstring axiom-docstring theorem-docstring term-docstring)
    :using (count-exists counting.count-exists-base counting.count-exists-step
            symbol-docstring symbol-base-class evidence-docstring axiom-docstring theorem-docstring term-docstring))

(defterm core-types-impl-count 6
    :evidence (evidence "atoms.py"
        :quotes ("class Symbol(str):" "Just a string with a distinct type" "Structured evidence: typed claims about a typed source" "An axiom: a foundational WFF" "A theorem: a WFF derived from" "A term/concept/primitive")
        :explanation "6 core type properties in source"))

(diff core-types-coverage
    :replace core-types-doc-count
    :with core-types-impl-count)

; --- 4. Evidence/provenance mechanism ---

(derive origin-provenance-bound origin-is-provenance
    :bind ((?origin axiom-has-origin) (?provenance theorem-has-derivation))
    :using (origin-is-provenance axiom-has-origin theorem-has-derivation))

(derive evidence-mechanism-doc-count
    (count-exists evidence-grounded-doc evidence-grounded-impl axiom-has-origin theorem-has-derivation theorem-default-origin)
    :using (count-exists counting.count-exists-base counting.count-exists-step
            evidence-grounded-doc evidence-grounded-impl axiom-has-origin theorem-has-derivation theorem-default-origin
            origin-provenance-bound))

(defterm evidence-mechanism-impl-count 5
    :evidence (evidence "atoms.py"
        :quotes ("def is_grounded" "return self.verified or self.verify_manual" "origin: \"str | Evidence\"" "derivation: list" "origin: \"str | Evidence\" = \"derived\"")
        :explanation "5 evidence/provenance features in source"))

(diff evidence-mechanism-coverage
    :replace evidence-mechanism-doc-count
    :with evidence-mechanism-impl-count)

; --- 5. Evidence status labels ---
; String-valued defterms — diff each against its code-branch counterpart

(defterm evidence-unverified-code "UNVERIFIED"
    :evidence (evidence "atoms.py"
        :quotes ("status = \"grounded\" if self.is_grounded else \"UNVERIFIED\"")
        :explanation "Unverified status label in Evidence.__str__"))

(diff evidence-unverified-label
    :replace evidence-unverified-status
    :with evidence-unverified-code)

(defterm evidence-grounded-code "grounded"
    :evidence (evidence "atoms.py"
        :quotes ("status = \"grounded\" if self.is_grounded else \"UNVERIFIED\"")
        :explanation "Grounded status label in Evidence.__str__"))

(diff evidence-grounded-label
    :replace evidence-grounded-status
    :with evidence-grounded-code)

; --- 6. DSL helpers ---

(derive dsl-helpers-doc-count
    (count-exists match-doc free-vars-doc substitute-doc to-sexp-doc)
    :using (count-exists counting.count-exists-base counting.count-exists-step
            match-doc free-vars-doc substitute-doc to-sexp-doc match-substitute-roundtrip))

(defterm dsl-helpers-impl-count 0
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state."
                 "Atoms is the foundation layer (pure types, no behavior). Grammar depends\n# on atoms for Symbol/Silence/WFF — that's correct.")
        :explanation "match/free_vars/substitute/to_sexp moved to the grammar layer — 0 DSL helpers remain in atoms.py"))

(diff dsl-helpers-coverage
    :replace dsl-helpers-doc-count
    :with dsl-helpers-impl-count)

; --- 7. Term display paths ---

(derive term-display-doc-count
    (count-exists term-forward-decl-display term-has-body-display)
    :using (count-exists counting.count-exists-base counting.count-exists-step
            term-forward-decl-display term-has-body-display))

(derive term-display-bound term-display-rule
    :bind ((?has-definition term-definition-check) (?to-sexp term-has-body-display) (?primitive term-forward-decl-display))
    :using (term-display-rule term-definition-check term-has-body-display term-forward-decl-display))

(defterm term-display-impl-count 2
    :evidence (evidence "atoms.py"
        :quotes ("(primitive)" "ParseltongueGrammar.enc(self.definition)")
        :explanation "2 display paths in Term.__str__"))

(derive term-display-full-doc-count
    (count-exists term-forward-decl-display term-has-body-display)
    :using (count-exists counting.count-exists-base counting.count-exists-step
            term-forward-decl-display term-has-body-display
            term-display-bound term-display-documented))

(diff term-display-coverage
    :replace term-display-full-doc-count
    :with term-display-impl-count)

; --- 8. Splat pattern support ---

(fact match-splat-impl false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "match() and its ?... splat matching moved to the grammar layer — not in atoms.py"))

(fact substitute-splat-impl false
    :evidence (evidence "atoms.py"
        :quotes ("Pure types. No grammar, no domain knowledge, no state.")
        :explanation "substitute() and its ?... splicing moved to the grammar layer — not in atoms.py"))

(derive splat-doc-count
    (count-exists match-splat-doc substitute-splat-doc)
    :using (count-exists match-splat-doc substitute-splat-doc))

(derive splat-impl-count
    (count-exists match-splat-impl substitute-splat-impl)
    :using (count-exists match-splat-impl substitute-splat-impl))

(derive splat-paired-count
    (count-exists (and match-splat-doc match-splat-impl)
                  (and substitute-splat-doc substitute-splat-impl))
    :using (count-exists match-splat-doc match-splat-impl substitute-splat-doc substitute-splat-impl))

(diff splat-paired-vs-doc
    :replace splat-doc-count
    :with splat-paired-count)

(diff splat-paired-vs-impl
    :replace splat-impl-count
    :with splat-paired-count)

(diff match-splat-pair
    :replace match-splat-doc
    :with match-splat-impl)

(diff substitute-splat-pair
    :replace substitute-splat-doc
    :with substitute-splat-impl)

; --- 9. Module contract (purity vs mutability) ---
; Docstring claims purity. Axiom: purity implies immutability.
; Code: all types are now frozen — diff confirms purity contract holds.

(defterm evidence-is-mutable (not evidence-is-frozen)
    :evidence (evidence "atoms.py"
        :quotes ("@dataclass(frozen=True, init=False)\nclass Evidence:")
        :explanation "Frozen dataclass is not mutable"))

(derive purity-immutable-bound purity-implies-immutable
    :bind ((?pure module-claims-pure-types) (?mutable evidence-is-mutable))
    :using (purity-implies-immutable module-claims-pure-types evidence-is-mutable))

(derive module-purity-contract
    (and module-claims-pure-types module-claims-no-domain)
    :using (module-claims-pure-types module-claims-no-domain
            module-is-stateless purity-immutable-bound))

(defterm all-types-immutable
    (and symbol-is-immutable evidence-is-frozen axiom-class-is-frozen
         theorem-class-is-frozen term-class-is-frozen)
    :evidence (evidence "atoms.py"
        :quotes ("class Symbol(str):\n    \"\"\"A symbol in Parseltongue. Just a string with a distinct type.\"\"\""
                 "@dataclass(frozen=True, init=False)\nclass Evidence:"
                 "@dataclass(frozen=True)\nclass Axiom:"
                 "@dataclass(frozen=True)\nclass Theorem:"
                 "@dataclass(frozen=True)\nclass Term:")
        :explanation "Symbol inherits immutable str; Evidence, Axiom, Theorem, Term are frozen dataclasses"))

(diff module-purity-vs-immutability
    :replace module-purity-contract
    :with all-types-immutable)

; --- 9. Evidence default grounding ---
; Docstring says grounding requires verified or manual.
; Code defaults both to False.
; Both paths independently prove: defaults don't satisfy grounding.

(defterm defaults-grounded-value
    (or evidence-verified-default evidence-verify-manual-default)
    :evidence (evidence "atoms.py"
        :quotes ("verified: bool = False"
                 "verify_manual: bool = False")
        :explanation "Both grounding fields default to False, OR yields False"))

; Doc path: bind docstring axiom with defaults
(derive bound-grounding-doc grounding-rule-doc
    :bind ((?grounded defaults-grounded-value)
           (?verified evidence-verified-default)
           (?manual evidence-verify-manual-default))
    :using (grounding-rule-doc defaults-grounded-value
            evidence-verified-default evidence-verify-manual-default))

; Code path: bind implementation axiom with defaults
(derive bound-grounding-impl grounding-rule-impl
    :bind ((?grounded defaults-grounded-value)
           (?verified evidence-verified-default)
           (?manual evidence-verify-manual-default))
    :using (grounding-rule-impl defaults-grounded-value
            evidence-verified-default evidence-verify-manual-default))

; Both prove true (vacuously) — doc and code agree
(diff evidence-defaults-grounding
    :replace bound-grounding-doc
    :with bound-grounding-impl)

; --- 10. Bool roundtrip consistency ---
; Parser: atom("true")→True, atom("false")→False
; Printer: to_sexp(True)→"true", to_sexp(False)→"false"
; Diff confirms roundtrip works for both values.

(derive bool-true-roundtrip
    (= atom-true-token to-sexp-bool-true)
    :using (atom-true-token to-sexp-bool-true bool-roundtrip-consistent))

(derive bool-false-roundtrip
    (= atom-false-token to-sexp-bool-false)
    :using (atom-false-token to-sexp-bool-false))

(diff bool-roundtrip-coverage
    :replace bool-true-roundtrip
    :with bool-false-roundtrip)

; --- 11. WFF/definition invariants across atom types ---
; Axiom and Theorem always carry a WFF (never None).
; Term has two modes: primitive (definition is None) or computed (definition is not None).
; Docstrings document these invariants; code enforces them structurally.
; 4 items × 2 layers (doc, impl) → paired count and diffs.

; --- Axioms (one per invariant) ---

(axiom axiom-has-wff (implies ?is-axiom ?has-wff)
    :evidence (evidence "atoms.py"
        :quotes ("Every axiom carries a wff (never None).")
        :explanation "Axiom docstring: being an axiom implies having a wff"))

(axiom theorem-has-wff (implies ?is-theorem ?has-wff)
    :evidence (evidence "atoms.py"
        :quotes ("Every theorem carries a wff (never None).")
        :explanation "Theorem docstring: being a theorem implies having a wff"))

(axiom term-primitive-mode (implies (not ?has-definition) ?is-primitive)
    :evidence (evidence "atoms.py"
        :quotes ("Has two modes: primitive (definition is None) or computed (definition is not None).")
        :explanation "Term docstring: no definition means primitive"))

(axiom term-computed-mode (implies ?has-definition ?is-computed)
    :evidence (evidence "atoms.py"
        :quotes ("Has two modes: primitive (definition is None) or computed (definition is not None).")
        :explanation "Term docstring: has definition means computed"))

; --- Doc-layer facts ---

(fact axiom-doc-wff true
    :evidence (evidence "atoms.py"
        :quotes ("An axiom: a foundational WFF assumed true, with evidence.")
        :explanation "Axiom docstring mentions WFF"))

(fact theorem-doc-wff true
    :evidence (evidence "atoms.py"
        :quotes ("A theorem: a WFF derived from facts, axioms, terms, or other theorems.")
        :explanation "Theorem docstring mentions WFF"))

(fact term-doc-primitive true
    :evidence (evidence "atoms.py"
        :quotes ("A term/concept/primitive introduced into the system.")
        :explanation "Term docstring mentions primitive"))

(fact term-doc-computed true
    :evidence (evidence "atoms.py"
        :quotes ("Has two modes: primitive (definition is None) or computed (definition is not None).")
        :explanation "Term docstring documents computed mode"))

; --- Impl-layer facts ---

(fact axiom-impl-wff true
    :evidence (evidence "atoms.py"
        :quotes ("class Axiom:\n    \"\"\"An axiom: a foundational WFF assumed true, with evidence.\n\n    Every axiom carries a wff (never None).\n    \"\"\"\n\n    name: str\n    wff: WFF")
        :explanation "Axiom class: wff is required field, no default"))

(fact theorem-impl-wff true
    :evidence (evidence "atoms.py"
        :quotes ("class Theorem:\n    \"\"\"A theorem: a WFF derived from facts, axioms, terms, or other theorems.\n\n    Every theorem carries a wff (never None).\n    \"\"\"\n\n    name: str\n    wff: WFF")
        :explanation "Theorem class: wff is required field, no default"))

(fact term-impl-primitive true
    :evidence (evidence "atoms.py"
        :quotes ("if self.definition is not None else \"(primitive)\"")
        :explanation "None definition displays as primitive"))

(fact term-impl-computed true
    :evidence (evidence "atoms.py"
        :quotes ("ParseltongueGrammar.enc(self.definition) if self.definition is not None")
        :explanation "Non-None definition displays via ParseltongueGrammar.enc"))

; --- Doc-side binds ---

(derive doc-axiom-wff axiom-has-wff
    :bind ((?is-axiom axiom-doc-wff) (?has-wff axiom-doc-wff))
    :using (axiom-has-wff axiom-doc-wff))

(derive doc-theorem-wff theorem-has-wff
    :bind ((?is-theorem theorem-doc-wff) (?has-wff theorem-doc-wff))
    :using (theorem-has-wff theorem-doc-wff))

; Doc path: primitive = no definition (false), computed = has definition (true)
(defterm term-doc-no-definition (not term-doc-primitive)
    :evidence (evidence "atoms.py"
        :quotes ("Has two modes: primitive (definition is None) or computed (definition is not None).")
        :explanation "Docstring: primitive mode means no definition — negation yields false"))

(derive doc-term-primitive term-primitive-mode
    :bind ((?has-definition term-doc-no-definition) (?is-primitive term-doc-primitive))
    :using (term-primitive-mode term-doc-no-definition term-doc-primitive))

(derive doc-term-computed term-computed-mode
    :bind ((?has-definition term-doc-computed) (?is-computed term-doc-computed))
    :using (term-computed-mode term-doc-computed))

; --- Impl-side binds ---

(derive impl-axiom-wff axiom-has-wff
    :bind ((?is-axiom axiom-impl-wff) (?has-wff axiom-impl-wff))
    :using (axiom-has-wff axiom-impl-wff))

(derive impl-theorem-wff theorem-has-wff
    :bind ((?is-theorem theorem-impl-wff) (?has-wff theorem-impl-wff))
    :using (theorem-has-wff theorem-impl-wff))

; Impl path: display branches on definition being None
(defterm term-impl-no-definition (not term-impl-primitive)
    :evidence (evidence "atoms.py"
        :quotes ("if self.definition is not None else \"(primitive)\"")
        :explanation "Code: None definition takes primitive branch — negation yields false"))

(derive impl-term-primitive term-primitive-mode
    :bind ((?has-definition term-impl-no-definition) (?is-primitive term-impl-primitive))
    :using (term-primitive-mode term-impl-no-definition term-impl-primitive))

(derive impl-term-computed term-computed-mode
    :bind ((?has-definition term-impl-computed) (?is-computed term-impl-computed))
    :using (term-computed-mode term-impl-computed))

; --- Counts and diffs ---

(derive wff-doc-count
    (count-exists doc-axiom-wff doc-theorem-wff doc-term-primitive doc-term-computed)
    :using (count-exists counting.count-exists-base counting.count-exists-step
            doc-axiom-wff doc-theorem-wff doc-term-primitive doc-term-computed))

(derive wff-impl-count
    (count-exists impl-axiom-wff impl-theorem-wff impl-term-primitive impl-term-computed)
    :using (count-exists counting.count-exists-base counting.count-exists-step
            impl-axiom-wff impl-theorem-wff impl-term-primitive impl-term-computed))

(derive wff-paired-count
    (count-exists (and doc-axiom-wff impl-axiom-wff)
                  (and doc-theorem-wff impl-theorem-wff)
                  (and doc-term-primitive impl-term-primitive)
                  (and doc-term-computed impl-term-computed))
    :using (count-exists counting.count-exists-base counting.count-exists-step
            doc-axiom-wff impl-axiom-wff
            doc-theorem-wff impl-theorem-wff
            doc-term-primitive impl-term-primitive
            doc-term-computed impl-term-computed))

(diff wff-paired-vs-doc :replace wff-paired-count :with wff-doc-count)
(diff wff-paired-vs-impl :replace wff-paired-count :with wff-impl-count)

; =====================================================================
; Exports — for core.pltg cross-checks against README
; =====================================================================

(derive export-core-types-confirmed
    (util.export module-claims-pure-types)
    :using (util.export module-claims-pure-types))

(derive export-splat-confirmed
    (util.export match-splat-impl)
    :using (util.export match-splat-impl))

(derive export-frozen-dataclasses
    (util.export evidence-is-frozen)
    :using (util.export evidence-is-frozen))

(derive export-symbol-is-str
    (util.export symbol-is-immutable)
    :using (util.export symbol-is-immutable))

(derive to-sexp-exists (= to-sexp-doc false) :using (to-sexp-doc))
(derive export-to-sexp
    (util.export to-sexp-exists)
    :using (util.export to-sexp-exists))

(derive export-match-substitute
    (util.export match-splat-doc)
    :using (util.export match-splat-doc))

(derive export-substitute-splat
    (util.export substitute-splat-doc)
    :using (util.export substitute-splat-doc))

; Parser pipeline stages: tokenize, read_tokens, parse/parse_all
(derive parser-stages-count
    (count-exists tokenize-doc read-tokens-doc parse-doc)
    :using (count-exists tokenize-doc read-tokens-doc parse-doc))

(derive export-parser-stages-count
    (util.export parser-stages-count)
    :using (util.export parser-stages-count))

